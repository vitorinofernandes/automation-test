{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "se/contact",
	"title": "SE Contact (Contact Form 7)",
	"category": "design",
	"icon": "email",
	"description": "Heading with a Contact Form 7 form and a call line.",
	"supports": { "html": false, "align": false },
	"render": "file:./render.php",
	"attributes": {
		"anchor": { "type": "string", "default": "contact" },
		"heading": { "type": "string", "default": "Book a free inspection." },
